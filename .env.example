# Copy to .env on the NAS. Never commit real account credentials.
APP_USER=your_phone_number
# Single quotes preserve dollar signs in Docker Compose .env parsing.
APP_PASSWORD='replace_with_your_password'
# Stable device identity is generated and saved in data/ if left empty.
DEVICECODE=
LOGIN_CRON='0 3,20 * * *'
PC_CRON='0 4,6 * * *'
CTYUN_IMAGE=ghcr.io/fengzhiqiu/ctyun-auto:latest
# QNAP example; adjust to the actual writable shared-folder path.
HOST_DATA_DIR=/share/Container/ctyun-auto/data
